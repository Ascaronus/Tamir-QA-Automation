# Пример переменных окружения: скопируйте в `.env` (файл в .gitignore).
# Значения-заглушки: реальные значения секретов в репозитории не хранятся.
QA_ENV=staging
WEB_URL=https://test.tamir.rs
API_URL=https://test-api.tamir.rs
# Ключ Medusa publishable — только из локального .env или из GitHub Actions secrets
MEDUSA_PUBLISHABLE_API_KEY=
# Kiwi TCMS (каталог кейсов и результаты прогонов): в CI — секреты репозитория
TCMS_URL=https://tcms.tamir.rs
TCMS_USER=
TCMS_PASSWORD=
