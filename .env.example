# Пример переменных окружения: скопируйте в `.env` (файл в .gitignore).
# Значения-заглушки: реальные значения секретов в репозитории не хранятся.
QA_ENV=staging
WEB_URL=https://test.tamir.rs
API_URL=https://test-api.tamir.rs
# Ключ Medusa publishable — только из локального .env или из GitHub Actions secrets
MEDUSA_PUBLISHABLE_API_KEY=
# Kiwi TCMS (каталог кейсов и перехватчик писем) и учётная запись тестового
# покупателя на стенде: в CI — секреты репозитория, здесь только имена.
TCMS_URL=https://tcms.tamir.rs
TCMS_USER=
TCMS_PASSWORD=
QA_WEB_EMAIL=
QA_WEB_PASSWORD=
MAILPIT_URL=
MAILPIT_USER=
MAILPIT_PASSWORD=
# Обход Turnstile на стенде: тот же токен, что прописан в backend/.env стенда
# (переменная QA_CAPTCHA_BYPASS_TOKEN). Бэкенд принимает его только для хостов
# из QA_CAPTCHA_BYPASS_HOSTNAMES стенда и никогда для боевого tamir.rs. Без него
# тесты регистрации, сброса пароля и отзыва падают честно (CAPTCHA_REQUIRED).
QA_CAPTCHA_BYPASS_TOKEN=

# Только для локального прогона, если у машины сломан DNS: закрепить адрес стенда
# вручную (Python-клиенты и Chromium получают его из одного списка). В CI не задавать.
# Формат: host=ip,host=ip
QA_HOST_OVERRIDES=
